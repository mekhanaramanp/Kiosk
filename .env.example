# ──────────────────────────────────────────────────
#  KIOSK – Saintgits Campus Food — Environment Config
# ──────────────────────────────────────────────────

PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=kiosk_db

# JWT (change this to a long random secret in production)
JWT_SECRET=kiosk_super_secret_key_change_me
JWT_EXPIRES_IN=8h

# Admin credentials (hashed on first seed)
ADMIN_EMAIL=admin@saintgits.org
ADMIN_PASSWORD=admin123

# Allowed email domain for students/faculty
ALLOWED_DOMAIN=saintgits.org
